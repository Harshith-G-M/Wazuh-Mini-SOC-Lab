<!--
Illustrative Wazuh local rules starter pack.
IMPORTANT:
- Validate against your installed Wazuh version and actual decoded event fields.
- Rule IDs 100100-100104 are example local IDs; ensure they do not conflict with your environment.
- Windows EventChannel field names and parent-rule behavior can vary by decoder/version.
- Use /var/ossec/bin/wazuh-logtest to test representative events before deployment.
- Back up local_rules.xml before editing and restart the manager only after validation.
-->
<group name="local,windows,">

  <!-- Repeated failed logons: tune frequency and timeframe to your environment.
       Parent rule 60122 is commonly used for Windows failed logon events in Wazuh
       rule sets, but confirm the actual parent rule in your installed version. -->
  <rule id="100100" level="10" frequency="5" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <same_source_ip />
    <description>Multiple Windows logon failures from the same source IP (validate as possible brute-force activity)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,brute_force,</group>
  </rule>

  <!-- Account creation: confirm actual event decoder fields and parent SID in your version. -->
  <rule id="100101" level="8">
    <if_sid>60135</if_sid>
    <description>Windows user account created — review whether the change was authorized</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
    <group>account_management,</group>
  </rule>

  <!-- Scheduled task creation: validate the event mapping and event channel first. -->
  <rule id="100102" level="8">
    <if_sid>60103</if_sid>
    <description>Windows scheduled task creation event — review task name, author and action</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>persistence,scheduled_task,</group>
  </rule>

  <!-- Sysmon process creation is useful for investigation. This is a broad
       example requiring environment-specific field matching before use. -->
  <rule id="100103" level="5">
    <field name="win.system.providerName">Microsoft-Windows-Sysmon</field>
    <field name="win.system.eventID">1</field>
    <description>Sysmon process creation event observed — review process, parent and command line</description>
    <group>sysmon,process_creation,</group>
  </rule>

  <!-- File integrity alerts are generated by Wazuh FIM configuration.
       This rule is intentionally not included: tune from actual alert JSON
       and the installed rule set instead of guessing field names. -->

</group>
